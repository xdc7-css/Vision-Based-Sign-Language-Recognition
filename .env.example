# ArSL Translation Overlay — Environment Configuration
# Copy to .env and adjust for your environment

# Logging
LOG_LEVEL=INFO

# Performance Profile: max_quality | balanced | max_performance | battery_saver
PERFORMANCE_PROFILE=balanced

# Active dialect: iraqi | saudi | egyptian
ACTIVE_DIALECT=iraqi

# Overlay defaults
OVERLAY_ENABLED=true
OVERLAY_X=100
OVERLAY_Y=100
OVERLAY_WIDTH=600
OVERLAY_HEIGHT=120
OVERLAY_FONT_SIZE=36
OVERLAY_OPACITY=85

# Recognition thresholds
WORD_THRESHOLD=0.85
DYNAMIC_THRESHOLD=0.75
ALPHABET_THRESHOLD=0.90

# Video source defaults
DEFAULT_SOURCE=webcam
DEFAULT_CAMERA_INDEX=0
